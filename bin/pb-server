#!/bin/sh
# MCP server shim (stdio). Claude Code starts this from the plugin; it must never write to stdout.
PB_SELF="$0"
. "$(dirname "$0")/_resolve.sh"
if [ ! -x "$NODE" ]; then
  echo "pantrybase: no node binary found (run: npx pantrybase install)" >&2
  exit 1
fi
if [ -z "$RUN" ]; then
  echo "pantrybase: $DIR has no dependencies installed and no stable copy is pinned in $PB_HOME/root-path (run: npx pantrybase install)" >&2
  exit 1
fi
exec "$NODE" "$RUN/dist/server.js" "$@"
